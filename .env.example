# Production build (npm run build) — public values only, safe to commit
VITE_API_URL=http://localhost:5050/api
# Google sign-in: OAuth Web client ID (same value as GOOGLE_CLIENT_ID in the backend .env)
VITE_GOOGLE_CLIENT_ID=1030821160613-vg3i6mkdatu6keb7j5e9kboe4opt0o0b.apps.googleusercontent.com

# Push notifications — Firebase Console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=

# Login OTP: "firebase" = real SMS via Firebase Phone Auth, "server" = test mode (OTP shown on screen)
VITE_OTP_PROVIDER=server

# Google Analytics 4 — Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX). Empty = analytics off
VITE_GA_MEASUREMENT_ID=
